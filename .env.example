# ==============================================================================
# REACHY — Environment Configuration Template
# Built by ISIRA Automations
# ==============================================================================
# Copy this file to `.env` in the repository root or to `~/.reachy/.env`.
# Reachy automatically loads environment variables from either location on startup.
#
# IMPORTANT SECURITY RULES:
# - NEVER commit `.env` or any production secrets to version control.
# - Keep filesystem permissions on `.env` restricted (e.g., chmod 0600 .env).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GOOGLE OAUTH 2.0 CREDENTIALS
# ------------------------------------------------------------------------------
# To connect a Gmail account via official OAuth 2.0 installed-app flow,
# register an application in the Google Cloud Console (https://console.cloud.google.com):
#
# 1. Create a project and enable the "Gmail API".
# 2. Configure the "OAuth consent screen":
#    - User Type: External (or Internal if using Google Workspace).
#    - Add your test sending emails under "Test users" while in Testing mode.
# 3. Go to "Credentials" -> "Create Credentials" -> "OAuth client ID".
#    - Application type: "Desktop app" (IMPORTANT: This IS your Client ID; do NOT select "Web app").
# 4. Copy the Client ID and Client Secret below.
#
# NOTE ON "DESKTOP ID" VS "CLIENT ID":
# When Google asks for "Application type", choose "Desktop app". A "Desktop app" credential
# IS an OAuth 2.0 Client ID. Google requires this type so Reachy can safely complete
# local loopback (http://localhost) authorization on your machine.
#
# With these set, `reachy accounts add-gmail --email you@example.com --permitted-use-acknowledged`
# will automatically open the Google OAuth consent flow without needing a JSON file.

REACHY_GOOGLE_CLIENT_ID=your-desktop-client-id.apps.googleusercontent.com
REACHY_GOOGLE_CLIENT_SECRET=GOCSPX-your-desktop-client-secret

# ------------------------------------------------------------------------------
# GOOGLE OAUTH SCOPES: WHAT NEEDS TO BE SELECTED & WHY
# ------------------------------------------------------------------------------
# When configuring the OAuth Consent Screen in Google Cloud Console, select the
# following four scopes:
#
# 1. `https://www.googleapis.com/auth/gmail.send`
#    - WHY IT IS NEEDED:
#      Grants Reachy permission to transmit outbound outreach emails from your Gmail
#      account via the official Google REST API (`users.messages.send`).
#    - WHY LEAST-PRIVILEGE:
#      This scope is strictly write-outbound. It does NOT allow reading existing
#      personal emails, modifying drafts, or deleting messages from your mailbox.
#
# 2. `https://www.googleapis.com/auth/gmail.readonly`
#    - WHY IT IS NEEDED:
#      Required for the autonomous agent to:
#      (a) Detect automated bounce notices (Delivery Status Notifications / 550 errors)
#          to automatically update lead health and halt failing campaigns.
#      (b) Synchronize prospective replies by threading `Message-ID` and `References`
#          headers, classifying replies (e.g., Interested, Not Interested, Out of Office).
#    - WHY LEAST-PRIVILEGE:
#      This scope is read-only. Reachy cannot delete, modify labels, or alter your
#      inbox messages.
#
# 3. `openid`
#    - WHY IT IS NEEDED:
#      Provides cryptographic verification of the user's OpenID identity during the
#      OAuth 2.0 authorization handshake.
#
# 4. `email`
#    - WHY IT IS NEEDED:
#      Returns the authenticated user's email address to verify that the authorized
#      Google account matches the sending identity configured in Reachy.
#
# WHY BROADER SCOPES (LIKE `mail.google.com` OR `gmail.modify`) ARE NEVER USED:
# - `mail.google.com` grants full, unrestricted read/write/delete access to everything.
# - Reachy strictly adheres to zero-trust, least-privilege security. We only request
#   the minimum necessary permissions to send outreach and read replies/bounces.
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# 2. ENCRYPTION & DATA SECURITY
# ------------------------------------------------------------------------------
# Fernet 32-byte urlsafe base64-encoded key used to encrypt OAuth tokens and SMTP
# passwords before writing to SQLite (`account_secrets` table).
#
# If not provided, Reachy generates a local key at `~/.reachy/secret.key` with 0600
# permissions. To generate your own key:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
REACHY_SECRET_KEY=

# Path to the secret encryption key file (default: ~/.reachy/secret.key)
# REACHY_SECRET_KEY_PATH=~/.reachy/secret.key

# ------------------------------------------------------------------------------
# 3. SAFE TESTING & RECIPIENT GUARDS
# ------------------------------------------------------------------------------
# During dry-runs, testing, and campaign validation, Reachy forces all email
# delivery to route ONLY to this test address. Outbound emails to any real prospect
# are strictly blocked unless running live with verified policies.
REACHY_TEST_RECIPIENT=reachy-test@example.com

# ------------------------------------------------------------------------------
# 4. AI COPYWRITING & SPAM AUDIT
# ------------------------------------------------------------------------------
# API Key for generating personalized subject lines and email body variants,
# matching proven outreach frameworks (e.g. Work-Done-First, Problem-Solver).
# Supports OpenAI, Anthropic, or compatible API endpoints.
REACHY_AI_KEY=sk-your-ai-api-key

# ------------------------------------------------------------------------------
# 5. SMTP / IMAP FALLBACK CREDENTIALS
# ------------------------------------------------------------------------------
# If you connect an account via standard SMTP/IMAP (`reachy accounts add-smtp`),
# store the password or app password in this environment variable.
REACHY_SMTP_PASSWORD=your-smtp-app-password

# ------------------------------------------------------------------------------
# 6. STORAGE & LOGGING
# ------------------------------------------------------------------------------
# Root home directory for Reachy runtime data (default: ~/.reachy)
# REACHY_HOME=~/.reachy

# Path to SQLite database (default: ~/.reachy/reachy.sqlite3)
# REACHY_DB=~/.reachy/reachy.sqlite3

# Path to structured JSON logs (default: ~/.reachy/reachy.log)
# REACHY_LOG=~/.reachy/reachy.log

# ------------------------------------------------------------------------------
# 7. DELIVERABILITY & COMPLIANCE POLICIES
# ------------------------------------------------------------------------------
# Allow outreach to catch-all domains (default: false; recommended: false)
REACHY_ALLOW_CATCH_ALL=false

# Perform active MX socket probe during lead verification (default: false)
REACHY_CATCH_ALL_PROBE=false

# Batch execution reconciliation grace period in seconds (default: 900)
REACHY_RECONCILE_GRACE=900

# Legal unsubscribe footer appended to all outbound outreach messages
REACHY_UNSUBSCRIBE_FOOTER=Reply with 'unsubscribe' and we will remove you from all future messages.
